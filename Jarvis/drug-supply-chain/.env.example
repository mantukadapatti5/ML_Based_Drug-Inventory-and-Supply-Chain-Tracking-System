# Copy to .env and adjust for host-machine development (scripts run outside Docker).
# Inside Docker Compose, these are set automatically in docker-compose.yml.

# PostgreSQL
DATABASE_URL=postgresql://jarvis_admin:SecretPassword123@localhost:5432/drug_supply_chain

# MongoDB (host port 27017 maps to pharma_mongodb container)
MONGODB_URL=mongodb://mongo_admin:MongoPassword123@localhost:27018/?authSource=admin
MONGO_DB=drug_supply_chain

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=pharma-influx-token
INFLUXDB_ORG=pharma_consortium
INFLUXDB_BUCKET=telemetry_stream

# MQTT — host uses localhost; Docker backend uses mosquitto
MQTT_HOST=localhost
MQTT_PORT=1883

# Redpanda/Kafka — host uses external port 19092; Docker backend uses redpanda:9092
KAFKA_SERVERS=localhost:19092

# Edge node simulator (edge/raspberry-pi/main.py)
EDGE_DEVICE_ID=pi-truck-001
EDGE_MQTT_HOST=localhost
EDGE_MQTT_PORT=1883

# Hyperledger Fabric (leave blank for mock ledger; set paths when peers are deployed)
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_CHANNEL=pharmacatena
FABRIC_CHAINCODE=provenance
FABRIC_MSP_ID=Org1MSP
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_TLS_CERT_PATH=

# Frontend (Vite dev — optional override; defaults to same origin + /ws proxy)
# VITE_API_BASE_URL=
# VITE_SOCKET_URL=http://localhost:3000

# GxP Part 11 — change in production
GXP_SIGNATURE_SALT=GxP_Secure_Salt_2026_CHANGE_IN_PRODUCTION
