# ============================================================================
# Phase 2: Hyperledger Fabric Configuration
# ============================================================================
# This file configures the transition from mock Fabric to live local network

# Operating Mode: "mock" for development, "production" for live Fabric network
# When transitioning to Phase 2, set this to "production" and provide credentials below
FABRIC_MODE=mock

# ============================================================================
# Local Fabric Test Network Settings (for ./network.sh up createChannel -ca)
# ============================================================================

# Channel and chaincode names (must match your network setup)
FABRIC_CHANNEL=drugchannel
FABRIC_CHAINCODE=drug_provenance

# Peer endpoint for local test network
# When running locally: localhost:7051 (outside container) or peer0.org1.example.com:7051 (inside network)
FABRIC_PEER_ENDPOINT=localhost:7051

# Organization MSP ID
FABRIC_MSP_ID=Org1MSP

# ============================================================================
# CREDENTIAL PATHS (Required when FABRIC_MODE=production)
# ============================================================================
# These point to files generated by: ./network.sh up createChannel -ca
# Default location: ~/.fabric-samples/test-network/organizations/

# Admin user certificate (PEM format)
# Path: ~/.fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/Admin@org1.example.com-cert.pem
FABRIC_CERT_PATH=

# Admin user private key (PEM format)
# Path: ~/.fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore/[key_filename]
FABRIC_KEY_PATH=

# TLS Certificate for peer (optional for local test-network)
# Path: ~/.fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/cacerts/tlsca.org1.example.com-cert.pem
FABRIC_TLS_CERT_PATH=

# Connection profile (optional, for fabric-gateway v1.0+)
# Can be generated from test-network or managed manually
FABRIC_CONNECTION_PROFILE_PATH=

# ============================================================================
# Keep mock ledger for graceful fallback (optional)
# ============================================================================
# Even with production mode, if credentials aren't fully configured,
# the system will fall back to mock ledger to prevent crashes
